# Application Environment
NODE_ENV=development
WEB_URL=http://localhost:5173
# Comma-separated origins allowed to call the API (defaults to WEB_URL)
CORS_ORIGINS=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
DEMO_STORE_PORT=4001
DEMO_STORE_URL=http://localhost:4001

# Database & Queue
# Local Docker:  postgresql://mirror:mirror_pass@localhost:5432/mirror_db
# Supabase: use the Session pooler URL (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
DATABASE_URL=postgresql://mirror:mirror_pass@localhost:5432/mirror_db
# Local Docker: redis://localhost:6379   Upstash: rediss://default:<token>@<name>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
AUTH_SECRET=change_me
# Hosts that may resolve to private addresses (local development only). Exact match, comma-separated.
ALLOWED_TEST_DOMAINS=localhost,127.0.0.1

# Artifact Storage (paths are resolved from the repository root)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# AI Provider Configuration (Optional Investigation Layer - not required)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Browser Worker Execution Limits
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_MS=60000
# Only set to true on hosts that cannot run Chromium's sandbox (some containers)
BROWSER_DISABLE_SANDBOX=false

# Evidence & Retention
MAX_SCREENSHOT_SIZE_MB=15
MAX_DOM_SNAPSHOT_SIZE_MB=10
EVIDENCE_RETENTION_DAYS=30

# Optional account created by `pnpm db:seed`; also adopts data created before auth existed
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Set to false to disable self-service sign-up
ALLOW_REGISTRATION=true
