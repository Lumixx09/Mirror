# Application Environment
NODE_ENV=development
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
DEMO_STORE_PORT=4001
DEMO_STORE_URL=http://localhost:4001

# Database & Queue
DATABASE_URL=postgresql://mirror:mirror_pass@localhost:5432/mirror_db
REDIS_URL=redis://localhost:6379

# Authentication & Security
AUTH_SECRET=mirror_dev_secret_change_in_production
ALLOWED_TEST_DOMAINS=localhost,127.0.0.1

# Artifact Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# AI Provider Configuration (Optional Investigation Layer)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Browser Worker Execution Limits
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_MS=60000

# Evidence & Retention
MAX_SCREENSHOT_SIZE_MB=15
MAX_DOM_SNAPSHOT_SIZE_MB=10
EVIDENCE_RETENTION_DAYS=30
