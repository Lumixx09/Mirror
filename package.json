{
  "name": "mirror-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MIRROR - The Differential Testing Laboratory for the Internet",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/**\" run dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm --recursive run typecheck",
    "db:generate": "pnpm --filter @mirror/db run generate",
    "db:migrate": "pnpm --filter @mirror/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @mirror/db run migrate:dev",
    "db:seed": "pnpm --filter @mirror/db run seed",
    "browsers:install": "pnpm --filter @mirror/worker exec playwright install chromium",
    "postinstall": "pnpm --filter @mirror/db run generate"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "fast-check": "^3.23.2",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
